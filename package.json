{
  "name": "@arapucajs/prettier",
  "description": "Prettier config preset for ArapucaJS packages and applications",
  "version": "1.1.0",
  "type": "module",
  "files": [
    "index.cjs"
  ],
  "main": "./index.cjs",
  "exports": {
    ".": "./index.cjs"
  },
  "scripts": {
    "prepare": "husky install",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "echo \"No tests specified\" && exit 0",
    "commit": "cz",
    "commitlint": "commitlint --edit"
  },
  "homepage": "https://github.com/arapucajs/prettier#readme",
  "bugs": {
    "url": "https://github.com/arapucajs/prettier/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arapucajs/prettier.git"
  },
  "keywords": [
    "prettier",
    "arapucajs"
  ],
  "author": "Jefte Costa <jefteamorim@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "provenance": true
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  }
}
